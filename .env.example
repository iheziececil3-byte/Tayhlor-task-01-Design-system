# ==============================================================================
# Tayhlor Environment Configuration Template (.env.example)
# Scope: Documents all required environment variables per .agents/rules/env.md (ENV-05)
# Note: Never commit real credentials or production secrets to version control.
# ==============================================================================

# --- Database: Vercel Postgres with pgvector (PRD Q12) ---
# Pooled runtime database connection string (used for application runtime queries)
POSTGRES_URL="postgres://default:password@ep-example-pooler.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
# Connection string configured with pgBouncer pooling for Prisma
POSTGRES_PRISMA_URL="postgres://default:password@ep-example-pooler.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require&pgbouncer=true"
# Direct unpooled connection string for Prisma CLI and migration operations
POSTGRES_URL_NON_POOLING="postgres://default:password@ep-example.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
# Individual connection credentials
POSTGRES_USER="default"
POSTGRES_HOST="ep-example.us-east-1.postgres.vercel-storage.com"
POSTGRES_PASSWORD="password"
POSTGRES_DATABASE="verceldb"

# --- Authentication: Auth.js (PRD Q6, accounts-and-access.md) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-secure-random-32-byte-hex-secret"

# --- Google OAuth Credentials (FR-01, FR-05) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Payments: Paystack Test Mode (FR-40 - FR-46, payments.md) ---
# Paystack test credentials must remain active during development and testing
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Transactional Email: Resend (FR-51, requirements.md) ---
# Requires a verified sending domain before production dispatch
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="orders@dwilliamshub.com"

# --- AI & Embeddings: Google Gemini API (PRD 7, Q5, Q13, faq-assistant.md) ---
GEMINI_API_KEY="AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

